# Doubao Seed / Volcengine Ark API template.
# Copy to .seed.env and fill real values locally or on the trusted remote server.
# Do not commit real values.

export ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
export ARK_API_KEY=
export ARK_MODEL=doubao-seed-2-0-mini-260428

# Optional defaults for eval judge. Benchmark scripts load this file directly.
export JUDGE=seed
export JUDGE_TASK=correctness

# Optional defaults for relabeling jobs.
export SEED_TEMPERATURE=0
export SEED_TOP_P=1
export SEED_MAX_TOKENS=1024

# Labeling mode:
# batch: send concurrent requests and collect/write train parquet in one run.
# online: same request path, kept for small debugging runs.
export SEED_MODE=batch
export SEED_WORKERS=4
